{
  "name": "@marrow/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply marrow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply marrow-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@marrow/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.40.0"
  }
}
