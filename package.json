{
  "name": "marrow",
  "version": "0.0.0",
  "private": true,
  "description": "Marrow — a sync engine for source code. Dropbox/Google Drive for developers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm --filter @marrow/server dev",
    "dev:client": "pnpm --filter @marrow/client-ui tauri dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @marrow/server db:generate",
    "db:migrate": "pnpm --filter @marrow/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
